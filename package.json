{
  "name": "oh-my-gemini",
  "version": "1.0.0",
  "description": "Unified Gemini CLI orchestration with task dependency graphs, lease tokens, critic/verifier planning, tmux teams, HUD, and MCP support",
  "type": "module",
  "bin": {
    "ogx": "./bin/ogx.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run build && npm test && npm run smoke",
    "presmoke": "npm run build",
    "smoke": "node scripts/exercise-runtime.mjs",
    "setup": "node dist/bin/ogx.js setup",
    "doctor": "node dist/bin/ogx.js doctor",
    "serve": "node dist/bin/server.js",
    "exercise:runtime": "node scripts/exercise-runtime.mjs",
    "dev": "tsx src/bin/ogx.ts",
    "dev:api": "tsx src/bin/server.ts",
    "deploy:gcp": "bash scripts/deploy-cloud-run.sh",
    "install:gcloud": "bash scripts/install-gcloud-local.sh",
    "clean": "rimraf dist"
  },
  "keywords": [
    "gemini",
    "cli",
    "orchestration",
    "tmux",
    "multi-agent",
    "developer-tools",
    "cloud-run",
    "runtime",
    "automation",
    "mcp",
    "hud"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KIM3310/ogx.git"
  },
  "bugs": {
    "url": "https://github.com/KIM3310/ogx/issues"
  },
  "homepage": "https://github.com/KIM3310/ogx#readme",
  "files": [
    "bin",
    "dist",
    "prompts",
    "skills",
    "templates",
    "docs",
    "README.md",
    "Dockerfile"
  ],
  "license": "MIT",
  "author": "Doeon Kim",
  "dependencies": {
    "commander": "^14.0.3",
    "nodemailer": "^8.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
