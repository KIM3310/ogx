# Gemini CLI command (default: "gemini")
# OGX_GEMINI_CMD=gemini

# HTTP server port (default: 8080)
# PORT=8080

# Operator access token (optional)
# OGX_OPERATOR_TOKEN=

# Runtime store path (default: .runtime/ogx-runtime-events.jsonl)
# OGX_RUNTIME_STORE_PATH=

# Worker mode (default: "echo")
# OGX_WORKER_MODE=echo

# Notification webhooks (optional)
# OGX_SLACK_WEBHOOK_URL=
# OGX_TELEGRAM_BOT_TOKEN=

# Vertex AI (optional)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_GENAI_USE_VERTEXAI=false

# MCP server log path (default: .omg/logs/mcp-server.log)
# OMG_MCP_LOG=
